{
  "info": {
    "name": "Summarecon — Order & Check-in (alur lengkap)",
    "_postman_id": "a1c4e7f2-3b8d-4e5a-9c6d-summarecon-order",
    "description": "Klik Run. Semua variabel terisi otomatis: kursi, order, QR, lalu scan sampai habis. Login login disimpan di cookie jar Postman, jadi jalankan sebagai satu rangkaian.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://summarecon-admin.axtra.tech"
    },
    {
      "key": "eventId",
      "value": "EVT-ATR-001"
    },
    {
      "key": "seatA",
      "value": ""
    },
    {
      "key": "seatB",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderCode",
      "value": ""
    },
    {
      "key": "qrToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login peserta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.test('role CUSTOMER', () => pm.expect(pm.response.json().data.user.role).to.eql('CUSTOMER'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nadia.demo@example.test\",\n  \"password\": \"Summarecon2026!\",\n  \"audience\": \"CUSTOMER\"\n}"
        }
      }
    },
    {
      "name": "2. Ambil 2 kursi tersedia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const free = pm.response.json().data.filter(s => s.status === 'AVAILABLE');",
              "pm.test('ada >= 2 kursi', () => pm.expect(free.length).to.be.above(1));",
              "pm.collectionVariables.set('seatA', free[0].event_seat_id);",
              "pm.collectionVariables.set('seatB', free[1].event_seat_id);",
              "console.log('dipakai:', free[0].seat_label, free[1].seat_label);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events/{{eventId}}/seats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            "{{eventId}}",
            "seats"
          ]
        }
      }
    },
    {
      "name": "3. Buat order (PAID + QR)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 dibuat', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('qr_token ada', () => pm.expect(d.qr_token).to.be.a('string'));",
              "pm.collectionVariables.set('orderId', d.order_id);",
              "pm.collectionVariables.set('orderCode', d.order_code);",
              "pm.collectionVariables.set('qrToken', d.qr_token);",
              "console.log('order', d.order_code, '| tiket', d.tickets, '| total', d.total_amount);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"seat_ids\": [\n    \"{{seatA}}\",\n    \"{{seatB}}\"\n  ],\n  \"attendee_name\": \"Uji Postman\",\n  \"simulate_payment\": true\n}"
        }
      }
    },
    {
      "name": "4. Kursi sama dipesan lagi -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ditolak 409', () => pm.response.to.have.status(409));",
              "pm.test('KURSI_SUDAH_DIAMBIL', () => pm.expect(pm.response.json().error.code).to.eql('KURSI_SUDAH_DIAMBIL'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"seat_ids\": [\n    \"{{seatA}}\"\n  ],\n  \"attendee_name\": \"Penyusup\",\n  \"simulate_payment\": true\n}"
        }
      }
    },
    {
      "name": "5. QR sebagai PNG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('png 200', () => pm.response.to.have.status(200));",
              "pm.test('image/png', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customer/orders/{{orderId}}/qr",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customer",
            "orders",
            "{{orderId}}",
            "qr"
          ],
          "query": [
            {
              "key": "format",
              "value": "png"
            }
          ]
        }
      }
    },
    {
      "name": "6. Scan tiket 1 (check-in)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 VALID', () => pm.response.to.have.status(200));",
              "pm.test('scan 1/2', () => pm.expect(pm.response.json().data.scan).to.eql('1/2'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-scan-code",
            "value": "SCAN-2026"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkin/public",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkin",
            "public"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qr_token_hash\": \"{{qrToken}}\",\n  \"event_id\": \"{{eventId}}\"\n}"
        }
      }
    },
